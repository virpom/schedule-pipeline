BOT_TOKEN=
ADMINS=123456789,987654321

# storage
SQLITE_PATH=/data/database.db

# schedule source
SCHEDULE_URL=https://polaruniversity.ru/obuchayushchimsya/raspisanie-zanyatiy/
BASE_URL=https://polaruniversity.ru

# poll every N seconds
POLL_INTERVAL=1800

# broadcast throttling: messages per second (Telegram limit ~30/s)
NOTIFY_RATE=20

# per-weekday photo folders (monday..sunday)
PHOTOS_PATH=/data/photos

# daily | permanent
MODE=daily
