# Конфигурация бота расписания ПТК.
# Скопируйте в .env и заполните BOT_TOKEN и ADMINS.

# --- Telegram ---
BOT_TOKEN=
ADMINS=123456789

# --- Хранилище ---
SQLITE_PATH=/data/database.db

# --- Источник расписания (ЭИОС колледжа) ---
# Блок «Политехнический колледж» на странице ЭИОС. Файлы (очное, замены,
# звонки) ищутся по ссылкам внутри этого блока.
SCHEDULE_URL=https://eios.norvuz.ru/mod/page/view.php?id=49960
BASE_URL=https://norvuz.ru

# --- Опрос сайта, сек ---
# Стартовое значение. Дальше интервал живёт в БД и меняется командой /setpoll.
POLL_INTERVAL=300

# --- Рассылка: сообщений в секунду (лимит Telegram ~30/с) ---
NOTIFY_RATE=20

# --- Папки с фото по дням недели (monday..sunday) ---
PHOTOS_PATH=/data/photos

# --- Часовой пояс ---
TZ=Asia/Krasnoyarsk
